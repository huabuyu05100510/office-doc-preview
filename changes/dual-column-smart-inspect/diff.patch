test.describe('智检 · 双栏对比 端到端', () => {
  test.beforeEach(async ({ page }) => {
    // 监听 console 错误（前端可观测）
    page.on('console', (msg) => {
      if (msg.type() === 'error') console.log('[browser-console-error]', msg.text())
    })
