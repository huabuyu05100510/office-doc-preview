// 双栏对比 / 智检 — 顶层弹层
// 模型：Claude MiniMax-M3
//
// 设计稿：
//   - 翻译对比.png：左侧原文 + 右侧改正 + 右栏错误列表 + 底部工具条
//   - 讯飞智检.png：左右两栏并排 + 顶部工具条 + 独立/同步滚动
//
// 实现策略：
//   - 单 Modal 双栏布局，源在左、对比在右
//   - 服务端字符级 diff（Myers @ /api/inspect/diff）
//   - 双 token 流：左栏只渲染 equal+delete，右栏只渲染 equal+insert
//   - 错误侧栏：编号 + 原文→改正 + ✓/+/− 按钮
//   - 同步滚动：模式 A（默认，按比例同步）；模式 B（独立）
import { useEffect, useRef, useState, useCallback, useMemo } from 'react'
import type { Task, InspectMode, InspectDiffResponse, RenderToken } from '../types'

interface Props {
  open: boolean
  source: Task | null
  compare: Task | null
  onClose: () => void
  // 默认智检模式（无 compare 时）
  defaultMode?: InspectMode
}

type ActionState = 'pending' | 'accepted' | 'ignored'

interface ErrorState {
  id: string
  state: ActionState
}

/** 安全 fetch 文本（截断超大内容，避免内存爆炸） */
async function fetchText(url: string, max = 200 * 1024): Promise<string> {
  const r = await fetch(url, { credentials: 'same-origin' })
  if (!r.ok) throw new Error(`fetch failed: ${r.status}`)
  const t = await r.text()
  return t.length > max ? t.slice(0, max) : t
}

export function InspectCompareModal({ open, source, compare, onClose, defaultMode = 'inspect' }: Props) {
  const [mode, setMode] = useState<InspectMode>(defaultMode)
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [diff, setDiff] = useState<InspectDiffResponse | null>(null)
  const [syncScroll, setSyncScroll] = useState(true)
  const [errorStates, setErrorStates] = useState<Record<string, ActionState>>({})
  const leftRef = useRef<HTMLDivElement>(null)
  const rightRef = useRef<HTMLDivElement>(null)
  const syncingRef = useRef(false)  // 防止双向同步循环

  // ESC 关闭
  useEffect(() => {
    if (!open) return
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') onClose() }
    window.addEventListener('keydown', onKey)
    return () => window.removeEventListener('keydown', onKey)
  }, [open, onClose])

  // 数据加载：取两份文本 → POST /api/inspect/diff
  const loadDiff = useCallback(async () => {
    if (!open || !source) return
    setLoading(true)
    setError(null)
    setErrorStates({})
    try {
      // 取源文本
      const leftText = await fetchText(source.originalUrl)
      // 取对比文本（compare 缺省时源文本做对比占位）
      const rightText = compare ? await fetchText(compare.originalUrl) : leftText
      const t0 = performance.now()
      const r = await fetch('/api/inspect/diff', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ left: leftText, right: rightText, granularity: 'char' })
      })
      if (!r.ok) throw new Error(`diff API ${r.status}`)
      const data: InspectDiffResponse = await r.json()
      const t1 = performance.now()
      console.info('[inspect] mode=', mode, 'source=', source.id, 'compare=', compare?.id || '(self)', 'ops=', data.ops.length, 'errors=', data.errors.length, 'ms=', (t1 - t0).toFixed(1))
      setDiff(data)
    } catch (e: any) {
      console.error('[inspect] load failed:', e)
      setError(String(e?.message || e))
    } finally {
      setLoading(false)
    }
  }, [open, source, compare, mode])

  useEffect(() => { loadDiff() }, [loadDiff])

  // 同步滚动：按比例同步（两侧高度独立，按 scrollTop / scrollHeight）
  const onLeftScroll = useCallback(() => {
    if (!syncScroll || syncingRef.current) return
    const l = leftRef.current
    const r = rightRef.current
    if (!l || !r) return
    const ratio = (l.scrollTop) / Math.max(1, l.scrollHeight - l.clientHeight)
    syncingRef.current = true
    r.scrollTop = ratio * Math.max(0, r.scrollHeight - r.clientHeight)
    requestAnimationFrame(() => { syncingRef.current = false })
  }, [syncScroll])
  const onRightScroll = useCallback(() => {
    if (!syncScroll || syncingRef.current) return
    const l = leftRef.current
    const r = rightRef.current
    if (!l || !r) return
    const ratio = (r.scrollTop) / Math.max(1, r.scrollHeight - r.clientHeight)
    syncingRef.current = true
    l.scrollTop = ratio * Math.max(0, l.scrollHeight - l.clientHeight)
    requestAnimationFrame(() => { syncingRef.current = false })
  }, [syncScroll])

  // 双 token 流：左栏只渲染 equal+delete；右栏只渲染 equal+insert
  const leftTokens = useMemo(() => (diff?.tokens || []).filter(t => t.type !== 'insert'), [diff])
  const rightTokens = useMemo(() => (diff?.tokens || []).filter(t => t.type !== 'delete'), [diff])

  // 侧栏错误状态变更
  const setErrorState = useCallback((id: string, state: ActionState) => {
    setErrorStates(prev => ({ ...prev, [id]: state }))
  }, [])

  if (!open || !source) return null

  return (
    <div className="inspect-compare-modal" data-testid="inspect-modal" role="dialog" aria-modal="true">
      <div className="inspect-compare-mask" onClick={onClose} />
      <div className="inspect-compare-body">
        <header className="inspect-compare-toolbar" data-testid="inspect-toolbar">
          <div className="inspect-compare-title">
            <span className="inspect-compare-icon">🔍</span>
            <span>智检 · 双栏对比</span>
            {diff && <span className="inspect-compare-stats">{diff.errors.length} 处错误 · {diff.ms}ms</span>}
          </div>
          <div className="inspect-compare-modes" role="group" aria-label="对比模式">
            <button
              type="button"
              className={`btn-mini ${mode === 'inspect' ? 'is-active' : ''}`}
              aria-pressed={mode === 'inspect'}
              onClick={() => setMode('inspect')}
            >
              智检
            </button>
            <button
              type="button"
              className={`btn-mini ${mode === 'dual' ? 'is-active' : ''}`}
              aria-pressed={mode === 'dual'}
              onClick={() => setMode('dual')}
            >
              双栏对比
            </button>
          </div>
          <div className="inspect-compare-sync">
            <label>
              <input type="checkbox" checked={syncScroll} onChange={e => setSyncScroll(e.target.checked)} />
              同步滚动
            </label>
          </div>
          <button type="button" className="btn-mini" onClick={onClose}>关闭 ✕</button>
        </header>

        <div className={`inspect-compare-grid mode-${mode}`}>
          {/* 左栏：源（原文 + 删除红线） */}
          <section
            className="inspect-compare-pane inspect-compare-left"
            data-testid="inspect-left"
            onScroll={onLeftScroll}
            ref={leftRef}
          >
            <div className="inspect-compare-pane-header">
              <span className="inspect-compare-pane-title">源</span>
              <span className="inspect-compare-pane-name" title={source.name}>{source.name}</span>
            </div>
            <div className="inspect-compare-pane-body" data-source-id={source.id}>
              {loading && <div className="center-msg">解析中…</div>}
              {error && (
                <div className="center-msg err">
                  加载失败：{error}
                  <div><button type="button" className="btn-mini" onClick={loadDiff}>重试</button></div>
                </div>
              )}
              {!loading && !error && diff && (
                <div className="inspect-tokens">
                  {leftTokens.map((t, i) => (
                    <RenderTokenSpan key={i} token={t} side="left" />
                  ))}
                </div>
              )}
            </div>
          </section>

          {/* 右栏：对比（改正 + 插入绿线） */}
          <section
            className="inspect-compare-pane inspect-compare-right"
            data-testid="inspect-right"
            onScroll={onRightScroll}
            ref={rightRef}
          >
            <div className="inspect-compare-pane-header">
              <span className="inspect-compare-pane-title">目标</span>
              <span className="inspect-compare-pane-name" title={compare?.name || source.name}>
                {compare?.name || source.name}
              </span>
            </div>
            <div className="inspect-compare-pane-body" data-target-id={compare?.id || source.id}>
              {loading && <div className="center-msg">解析中…</div>}
              {error && (
                <div className="center-msg err">
                  加载失败：{error}
                  <div><button type="button" className="btn-mini" onClick={loadDiff}>重试</button></div>
                </div>
              )}
              {!loading && !error && diff && (
                <div className="inspect-tokens">
                  {rightTokens.map((t, i) => (
                    <RenderTokenSpan key={i} token={t} side="right" />
                  ))}
                </div>
              )}
            </div>
          </section>

          {/* 错误侧栏 */}
          <aside className="inspect-compare-sidebar" data-testid="inspect-diff-sidebar">
            <div className="inspect-compare-sidebar-header">
              错误列表 {diff && `(${Object.values(errorStates).filter(s => s === 'accepted').length}/${diff.errors.length} 已接受)`}
            </div>
            <ul className="inspect-compare-error-list">
              {diff?.errors.map((err) => {
                const st = errorStates[err.id] || 'pending'
                return (
                  <li
                    key={err.id}
                    data-error-id={err.id}
                    className={`inspect-compare-error-item is-${st}`}
                  >
                    <div className="inspect-compare-error-pair">
                      <span className="inspect-compare-error-original">{err.original || '∅'}</span>
                      <span className="inspect-compare-error-arrow">→</span>
                      <span className="inspect-compare-error-corrected">{err.corrected || '∅'}</span>
                    </div>
                    <div className="inspect-compare-error-actions">
                      <button
                        type="button"
                        className="btn-mini"
                        title="接受此修改"
                        onClick={() => setErrorState(err.id, 'accepted')}
                      >
                        ✓ 接受
                      </button>
                      <button
                        type="button"
                        className="btn-mini"
                        title="忽略此修改"
                        onClick={() => setErrorState(err.id, 'ignored')}
                      >
                        − 忽略
                      </button>
                    </div>
                  </li>
                )
              })}
              {diff && diff.errors.length === 0 && (
                <li className="inspect-compare-empty">✓ 暂无错误</li>
              )}
            </ul>
          </aside>
        </div>

        <footer className="inspect-compare-footer">
          <span className="inspect-compare-footer-hint">
            智检由 Myers diff 引擎驱动 ·{' '}
            {diff && <code>X-Diff-Ms={diff.ms}</code>}
          </span>
        </footer>
      </div>
    </div>
  )
}

function RenderTokenSpan({ token, side }: { token: RenderToken; side: 'left' | 'right' }) {
  // 左栏：equal/delete；右栏：equal/insert
  // 设计稿：原文错误红色下划线，改正绿色
  let cls = 'diff-token'
  if (token.type === 'delete') cls += ' diff-token-delete'
  else if (token.type === 'insert') cls += ' diff-token-insert'
  else cls += ' diff-token-equal'
  return <span className={cls} data-side={side} data-type={token.type}>{token.text}</span>
}
