+/** 渲染第 1 页为缩略图。返回 PNG 路径。失败抛错。 */
+export async function rasterizeThumb(filePath, outPath, dpi = CONFIG.RASTERIZE_THUMB_DPI) {
+  fs.mkdirSync(path.dirname(outPath), { recursive: true })
+  const outDir = path.dirname(outPath)
