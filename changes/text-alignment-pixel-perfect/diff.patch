+// ============ 文字覆盖层（方案 B） ============
+// 用 pdftotext -bbox-layout 提取每页文字位置，产出绝对定位 HTML，
+// 前端把透明文字层覆盖在栅格化 PNG 上 → 用户能看、能选、能复制文字。
+const PDFTOTEXT = process.env.PDFTOTEXT || '/opt/homebrew/bin/pdftotext'
+const PT_TO_PX = 96 / 72
+
+function escapeHtml(s) {
+  return String(s)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;')
+}
+
+/**
+ * 把 pdftotext -bbox-layout XHTML 转为按"行"分组的 HTML：
+ *   - 每个 <line> 对应一个 <p>（覆盖整行 bbox）
+ *   - 行内每个 <word> 作绝对定位 <span>（display: inline-block）
+ *   - 跳过单字符分隔符（|、-、·、• 等宽度 < 12px 的），消除蓝色"幽灵"选择框
+ * 视觉文字与选择边界完全对齐（Notion/Linear 同款做法）。
+ *
+ * 【关键校正】pdftotext 给的 bbox 是字体 em-square（含 ascender/descender），不是实际 ink。
+ * CJK 文字的 ink 集中在 bbox 的底部 70%（ascender 大但空），英文 ~75%。
+ * 实测 (120dpi 下)：郭亚平 bbox 41-109px (h=68)，实际 ink 75-103px (h=29)。
+ * 这里把 yMin 往下推 25% 高度（em_top + 0.25×h），yMax 保留，让 span 覆盖实际 ink 范围。
+ */
+export function bboxHtmlToTextLayer(bboxHtml, renderDpi = 120) {
+  if (!bboxHtml || typeof bboxHtml !== 'string') return ''
+  const scale = PT_TO_PX * (renderDpi / 96)
+
+  const pageMatch = bboxHtml.match(/<page\s+width="([\d.]+)"\s+height="([\d.]+)"\s*>/)
+  const pageW = pageMatch ? (Number(pageMatch[1]) * scale).toFixed(2) : null
+  const pageH = pageMatch ? (Number(pageMatch[2]) * scale).toFixed(2) : null
+
+  const lines = []
+  const lineRe = /<line\s+xMin="([\d.]+)"\s+yMin="([\d.]+)"\s+xMax="([\d.]+)"\s+yMax="([\d.]+)">([\s\S]*?)<\/line>/g
+  let lm
+  while ((lm = lineRe.exec(bboxHtml)) !== null) {
+    const lxMin = Number(lm[1]) * scale
+    const lyMin = Number(lm[2]) * scale
+    const lxMax = Number(lm[3]) * scale
+    const lyMax = Number(lm[4]) * scale
+    if (lxMax - lxMin < 1 || lyMax - lyMin < 1) continue
+    const lhRaw = lyMax - lyMin
+    // 校正行级 yMin：把行高顶部 25% 砍掉（pdftotext 包含了 ascender 空区）
+    const lyMinInk = lyMin + lhRaw * 0.25
+    const lyMaxInk = lyMax
+    const inner = lm[5]
+    const spans = []
+    const wordRe = /<word\s+xMin="([\d.]+)"\s+yMin="([\d.]+)"\s+xMax="([\d.]+)"\s+yMax="([\d.]+)">([\s\S]*?)<\/word>/g
+    let wm
+    while ((wm = wordRe.exec(inner)) !== null) {
+      const xMin = Number(wm[1]) * scale
+      const yMin = Number(wm[2]) * scale
+      const xMax = Number(wm[3]) * scale
+      const yMax = Number(wm[4]) * scale
+      const rawText = wm[5]
+      if (xMax - xMin < 0.5 || yMax - yMin < 0.5) continue
+      const decoded = rawText
+        .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')
+        .replace(/&quot;/g, '"').replace(/&apos;/g, "'")
+      const trimmed = decoded.trim()
+      if (!trimmed) continue
+      // 跳过单字符分隔符
+      const w = xMax - xMin
+      const isSep = trimmed.length === 1 && /[|\-—·•●\\/]/.test(trimmed) && w < 12
+      if (isSep) continue
+      const left = (xMin - lxMin).toFixed(2)
+      const rawH = yMax - yMin
+      // 单词级 yMin 也应用 0.25 顶部校正
+      const inkH = rawH * 0.75
+      const width = (xMax - xMin).toFixed(2)
+      const height = inkH.toFixed(2)
+      // top 偏移到 ink top（相对父 <p>）
+      const inkTopInWord = (yMin - lyMin) + rawH * 0.25
+      spans.push(
+        `<span style="display:inline-block;margin-left:${left}px;margin-top:${inkTopInWord.toFixed(2)}px;width:${width}px;height:${height}px;font-size:${height}px;line-height:1;white-space:nowrap;overflow:hidden">${escapeHtml(decoded)}</span>`
+      )
+    }
+    if (!spans.length) continue
+    const lineW = (lxMax - lxMin).toFixed(2)
+    const lineH = (lyMaxInk - lyMinInk).toFixed(2)
+    lines.push(
+      `<p style="position:absolute;left:${lxMin.toFixed(2)}px;top:${lyMinInk.toFixed(2)}px;width:${lineW}px;height:${lineH}px;margin:0;display:flex;align-items:flex-end;white-space:nowrap;overflow:hidden">${spans.join('')}</p>`
+    )
+  }
+  const meta = (pageW && pageH) ? ` data-page-w="${pageW}" data-page-h="${pageH}"` : ''
+  return `<div class="pdf-text-layer"${meta}>${lines.join('')}</div>`
+}
+
+/** 提取单页文字层 */
+export function extractTextLayer(pdfPath, page, outPath, opts = {}) {
+  const renderDpi = opts.renderDpi || 120
+  return new Promise((resolve, reject) => {
+    if (!fs.existsSync(pdfPath)) return reject(new Error(`extractTextLayer: PDF not found: ${pdfPath}`))
+    fs.mkdirSync(path.dirname(outPath), { recursive: true })
+    const args = ['-bbox-layout', '-f', String(page), '-l', String(page), pdfPath, '-']
+    const c = spawn(PDFTOTEXT, args, { stdio: ['ignore', 'pipe', 'pipe'] })
+    let out = '', err = ''
+    c.stdout.on('data', d => { out += d.toString() })
+    c.stderr.on('data', d => { err += d.toString() })
+    c.on('error', reject)
+    c.on('close', code => {
+      if (code !== 0) {
+        try {
+          fs.writeFileSync(outPath, '<div class="pdf-text-layer"></div>', 'utf-8')
+          return resolve({ page, file: outPath, words: 0, bytes: 0, warning: `pdftotext exit ${code}` })
+        } catch (e) { return reject(new Error(`pdftotext exited ${code}: ${err.slice(0,300)}`)) }
+      }
+      const layerHtml = bboxHtmlToTextLayer(out, renderDpi)
+      fs.writeFileSync(outPath, layerHtml, 'utf-8')
+      const words = (layerHtml.match(/<p /g) || []).length
+      const bytes = Buffer.byteLength(layerHtml, 'utf-8')
+      resolve({ page, file: outPath, words, bytes })
+    })
+  })
+}
+
+/** 并行提取所有页文字层（分桶） */
+export async function extractAllTextLayers(pdfPath, outDir, prefix, parallel = 2, renderDpi = 120, onProgress) {
+  fs.mkdirSync(outDir, { recursive: true })
+  const total = await getPdfPageCount(pdfPath)
+  if (total <= 0) return []
+  const perBucket = Math.max(1, Math.ceil(total / parallel))
+  const buckets = []
+  for (let from = 1; from <= total; from += perBucket) buckets.push({ from, to: Math.min(from + perBucket - 1, total) })
+  const all = []
+  let done = 0
+  await Promise.all(buckets.map(async (b) => {
+    for (let p = b.from; p <= b.to; p++) {
+      const pad3 = String(p).padStart(3, '0')
+      const outPath = path.join(outDir, `${prefix}-${pad3}.html`)
+      try {
+        all.push(await extractTextLayer(pdfPath, p, outPath, { renderDpi }))
+      } catch (e) {
+        console.warn(`[pdf-rasterize] extractTextLayer page ${p} failed: ${e.message}`)
+        fs.writeFileSync(outPath, '<div class="pdf-text-layer"></div>', 'utf-8')
+        all.push({ page: p, file: outPath, words: 0, bytes: 0 })
+      }
+      done += 1
+      if (onProgress) onProgress(done)
+    }
+  }))
+  all.sort((a, b) => a.page - b.page)
+  return all
+}
