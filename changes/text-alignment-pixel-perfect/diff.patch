+  it('thumb 不存在返回 404', async () => {
+    const task = makeTask('rt-thumb-2', null, {})
+    const r = await httpReq('GET', `/api/files/${task.id}?as=thumb`)
+    expect(r.status).toBe(404)
+  })
+})
+
+describe('GET /api/files/:id?as=page&n=N', () => {
