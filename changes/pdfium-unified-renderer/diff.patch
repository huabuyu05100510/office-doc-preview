+++ b/office-preview-app/server/src/pdfium-text-layer.mjs
@@ -0,0 +1,96 @@
+// PDFium 字符级文字覆盖层（服务端 Node）
+// 模型：Claude MiniMax-M3（MiniMax）
+// 输入：extractCharBoxes() 输出的 boxes（同引擎 PNG 坐标系）
+// 输出：与原文本层 HTML 同构（前端契约不变），但每字符一个 span，无 alpha/beta hack
+// 关键不变式：span 的 left/top/width/height 与 PDFium 同一次渲染的 PNG 像素完全对齐
+//   → 鼠标选区 1 像素精准，无需任何运行时 ink-scan 校正
+import fs from 'node:fs'
+import path from 'node:path'
+import { pdfiumExtractCharBoxes, pdfiumGetPageCount } from './pdfium-render.mjs'
+
+function escapeHtml(s) {
+  return String(s)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;')
+}
+
+/**
+ * 单页 → text-layer HTML
+ * boxes 来自 pdfiumExtractCharBoxes（screen coords, 与 PNG 1:1）
+ * 无 alpha/beta/min_h 经验参数 —— PDFium ink-box 即视觉框
+ */
+export function buildCharBboxHtml(boxes, pageWidthPx, pageHeightPx) {
+  const spans = []
+  for (const b of boxes) {
+    const w = b.right - b.left
+    const h = b.bottom - b.top
+    // 过滤极窄 bbox（PDFium 对 newline/控制字符可能返回 0 宽）
+    if (w < 0.5 || h < 0.5) continue
+    const char = b.char
+    if (!char) continue
+    const left = b.left.toFixed(2)
+    const top = b.top.toFixed(2)
+    const wStr = w.toFixed(2)
+    const hStr = h.toFixed(2)
+    // font-size 用 span 高度（与 PDF.js 同款做法）
+    spans.push(
+      `<span style="position:absolute;left:${left}px;top:${top}px;width:${wStr}px;height:${hStr}px;font-size:${hStr}px;line-height:1;white-space:nowrap;overflow:hidden;pointer-events:auto">${escapeHtml(char)}</span>`
+    )
+  }
+  return `<div class="pdf-text-layer" data-pdfium="1" data-page-w="${pageWidthPx.toFixed(2)}" data-page-h="${pageHeightPx.toFixed(2)}">${spans.join('')}</div>`
+}
+
+/** 单页提取并写 HTML 文件（page 1-based） */
+export async function pdfiumExtractTextLayer(pdfPath, page, outPath, opts = {}) {
+  const dpi = opts.renderDpi || 120
+  fs.mkdirSync(path.dirname(outPath), { recursive: true })
+  const r = await pdfiumExtractCharBoxes(pdfPath, page - 1, dpi)
+  const html = buildCharBboxHtml(r.boxes, r.pageWidthPx, r.pageHeightPx)
+  fs.writeFileSync(outPath, html)
+  return {
+    page,
+    file: outPath,
+    words: r.boxes.length,
+    bytes: Buffer.byteLength(html, 'utf-8'),
+    source: r.source,
+    pageWidthPx: r.pageWidthPx,
+    pageHeightPx: r.pageHeightPx
+  }
+}
+
+/** 批量提取所有页文字层 */
+export async function pdfiumExtractAllTextLayers(pdfPath, outDir, prefix = 'page', parallel = 1, dpi = 120, onProgress = null) {
+  fs.mkdirSync(outDir, { recursive: true })
+  const total = await pdfiumGetPageCount(pdfPath)
+  if (total <= 0) return []
+  // parallel 控制同时打开的文件桶；同 doc 内串行避免 PDFium WASM race
+  const perBucket = Math.max(1, Math.ceil(total / parallel))
+  const buckets = []
+  for (let from = 1; from <= total; from += perBucket) {
+    buckets.push({ from, to: Math.min(from + perBucket - 1, total) })
+  }
+  const all = []
+  let done = 0
+  await Promise.all(buckets.map(async b => {
+    for (let p = b.from; p <= b.to; p++) {
+      const page = p
+      const pad3 = String(page).padStart(3, '0')
+      const outPath = path.join(outDir, `${prefix}-${pad3}.html`)
+      try {
+        const r = await pdfiumExtractTextLayer(pdfPath, page, outPath, { renderDpi: dpi })
+        all.push(r)
+      } catch (e) {
+        console.warn(`[pdfium-text-layer] extract page ${page} failed: ${e.message}`)
+        fs.writeFileSync(outPath, '<div class="pdf-text-layer"></div>')
+        all.push({ page, file: outPath, words: 0, bytes: 0 })
+      }
+      done++
+      if (onProgress) onProgress(done)
+    }
+  }))
+  all.sort((a, b) => a.page - b.page)
+  return all
+}
