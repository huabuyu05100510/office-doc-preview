diff --git a/office-preview-app/web/src/styles.css b/office-preview-app/web/src/styles.css
index 4addff0..25432b4 100644
--- a/office-preview-app/web/src/styles.css
+++ b/office-preview-app/web/src/styles.css
@@ -331,3 +331,26 @@ a { color: inherit; text-decoration: none; }
 /* 上传进度条 */
 .upload-bar { width: 100%; max-width: 360px; height: 6px; margin: 8px auto 0; background: var(--border); border-radius: 999px; overflow: hidden; }
 .upload-bar-fill { height: 100%; background: linear-gradient(90deg, var(--primary), #5aa0ff); border-radius: 999px; transition: width .15s linear; }
+
+/* ============== 图片+文字层预览（最小必要 CSS） ============== */
+/* HEAD 时代完全缺失这些样式，git checkout 丢了滚动 + 容器高度：
+   1) .pdf-images-root 必须是 flex column + height: 100%，让 frame 抢占 modal-body 剩余空间
+   2) .pdf-images-frame 必须是 flex:1 + overflow:auto，否则内容超出无法滚动
+   3) wrapper position: relative + img 100% 撑满（避免窄窗缩放断层）
+   4) text-layer inset:0 撑满 wrapper + color: transparent（让 span 文字不可见）
+   5) text-layer span position: absolute + color: transparent
+   6) text-layer 自己 pointer-events: auto（让鼠标可选中）
+   注：不加 font-family（避免字体渲染差异）、不加 ::selection 自定义（保持浏览器默认）
+        不加 -webkit-touch-callout（避免触发触屏特殊行为）
+*/
+.pdf-images-root { display: flex; flex-direction: column; height: 100%; min-height: 0; }
+.pdf-images-toolbar { display: flex; justify-content: space-between; align-items: center; padding: 8px 16px; font-size: 13px; border-bottom: 1px solid var(--border); background: var(--bg-elev); flex-shrink: 0; }
+.pdf-images-meta { color: var(--text-sub); font-size: 12px; }
+.pdf-images-frame { flex: 1 1 auto; min-height: 0; overflow: auto; padding: 16px; display: flex; flex-direction: column; align-items: center; }
+.pdf-image-page { position: relative; margin-bottom: 12px; }
+.pdf-images-page { display: block; width: 100%; height: 100%; }
+.pdf-text-layer {
+  position: absolute; inset: 0; pointer-events: auto;
+  color: transparent; user-select: text; cursor: text; z-index: 1;
+}
+.pdf-text-layer span { position: absolute; color: transparent; }
