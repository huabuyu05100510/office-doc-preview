diff --git a/office-preview-app/web/src/styles.css b/office-preview-app/web/src/styles.css
index 4addff0..b5f57c8 100644
--- a/office-preview-app/web/src/styles.css
+++ b/office-preview-app/web/src/styles.css
@@ -331,3 +331,62 @@ a { color: inherit; text-decoration: none; }
 /* 上传进度条 */
 .upload-bar { width: 100%; max-width: 360px; height: 6px; margin: 8px auto 0; background: var(--border); border-radius: 999px; overflow: hidden; }
 .upload-bar-fill { height: 100%; background: linear-gradient(90deg, var(--primary), #5aa0ff); border-radius: 999px; transition: width .15s linear; }
+
+/* ============== 模式切换 / 进度 / 文字覆盖层（方案 B） ============== */
+.mode-toggle {
+  display: inline-flex; gap: 2px; padding: 2px;
+  background: rgba(15, 23, 42, .04); border-radius: 6px;
+  margin-right: 8px;
+}
+.mode-toggle .btn-mini { padding: 4px 10px; font-size: 12px; border: none; background: transparent; }
+.mode-toggle .btn-mini.is-active {
+  background: var(--bg-elev); color: var(--primary);
+  box-shadow: 0 1px 2px rgba(15,23,42,.08);
+  font-weight: 600;
+}
+
+.progress { width: 320px; max-width: 80%; margin: 16px auto 0; text-align: center; }
+.progress-bar { height: 6px; background: linear-gradient(90deg, var(--primary), #5aa0ff); border-radius: 999px; transition: width .25s ease; }
+.progress-text { margin-top: 8px; font-size: 12px; color: var(--text-sub); font-variant-numeric: tabular-nums; }
+
+/* 图片模式滚动容器 */
+.pdf-images-root { display: flex; flex-direction: column; height: 100%; min-height: 0; }
+.pdf-images-toolbar {
+  display: flex; justify-content: space-between; align-items: center;
+  padding: 8px 16px; font-size: 13px;
+  border-bottom: 1px solid var(--border);
+  background: var(--bg-elev); flex-shrink: 0;
+}
+.pdf-images-meta { color: var(--text-sub); font-size: 12px; }
+.pdf-images-frame { flex: 1 1 auto; min-height: 0; overflow: auto; padding: 16px; display: flex; flex-direction: column; align-items: center; scroll-behavior: smooth; }
+
+/* 页面图 + 文字覆盖层（透明但可选可复制） */
+.pdf-image-page { position: relative; margin-bottom: 12px; }
+/* 关键：img 不再 max-width: 100%，否则窄窗下 img 被压缩而 wrapper/text-layer 用内联像素不变，文字层与图片错位。
+   缩放由 frame 容器的 overflow:auto 滚动条处理（与 .docx-root 一致）。
+   这里显式 width:100%; height:100% 让 img 严格撑满 wrapper（与文字层 inset:0 坐标系 1:1）。 */
+.pdf-images-page { background: #fff; box-shadow: 0 4px 16px rgba(15, 23, 42, .12); border-radius: 4px; display: block; width: 100%; height: 100%; }
+.pdf-text-layer {
+  position: absolute; inset: 0; pointer-events: auto;
+  color: transparent;
+  user-select: text;
+  cursor: text;
+  z-index: 1;
+}
+/* 文字层子元素全部用绝对定位（与 pdftotext bbox 1:1 对齐，无 flex 二次计算）
+   关键：span 文字必须 color: transparent（不显示文字本身），
+   视觉上看到的字是底层 PNG（poppler 渲染的 PDF 原字体），文字层只负责"选区"和"复制"。
+   不写 color: transparent 会让 span 文字用浏览器默认字体显示出来，跟图片字体不一致 → 视觉错乱。 */
+.pdf-text-layer span {
+  position: absolute;
+  user-select: text;
+  display: block;
+  color: transparent;
+  /* 文字用与 docx 一致的字体栈，匹配底层 PNG 字体（中英文都用系统字体，避免出现明显差异） */
+  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', 'Hiragino Sans GB', 'WenQuanYi Micro Hei', sans-serif;
+}
+.pdf-text-layer::selection,
+.pdf-text-layer *::selection {
+  background: rgba(47, 107, 255, 0.3);
+  color: transparent;
+}
