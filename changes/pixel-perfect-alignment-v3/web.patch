 .upload-bar-fill { height: 100%; background: linear-gradient(90deg, var(--primary), #5aa0ff); border-radius: 999px; transition: width .15s linear; }
+
+/* ============== 模式切换 / 进度 / 文字覆盖层（方案 B） ============== */
+.mode-toggle {
+  display: inline-flex; gap: 2px; padding: 2px;
+  background: rgba(15, 23, 42, .04); border-radius: 6px;
+  margin-right: 8px;
+}
+.mode-toggle .btn-mini { padding: 4px 10px; font-size: 12px; border: none; background: transparent; }
+.mode-toggle .btn-mini.is-active {
+  background: var(--bg-elev); color: var(--primary);
+  box-shadow: 0 1px 2px rgba(15,23,42,.08);
