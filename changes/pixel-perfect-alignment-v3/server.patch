+// ============ 高层包装 ============
+
+/** 渲染第 1 页为缩略图。返回 PNG 路径。失败抛错。 */
+export async function rasterizeThumb(filePath, outPath, dpi = CONFIG.RASTERIZE_THUMB_DPI) {
+  fs.mkdirSync(path.dirname(outPath), { recursive: true })
+  const outDir = path.dirname(outPath)
+  const prefix = path.basename(outPath, '.png')
+  const results = await rasterizePages(filePath, 1, 1, dpi, outDir, prefix)
+  if (!results.length) throw new Error('rasterizeThumb: pdftoppm produced no file')
+  // pdftoppm 会自动加 -N 后缀，重命名为预期的 outPath
+  const actual = results[0].file
+  if (actual !== outPath) {
+    fs.renameSync(actual, outPath)
+  }
+  return outPath
+}
+
+/** 渲染全部页为 PNG。支持并发（分桶）。
+ *  onProgress(done) 每完成一页调用一次（累加）。
+ *  返回 [{ page, file, width, height }, ...] 数组。
+ *  width/height 从 PNG IHDR 头读取（24 字节 IO，可忽略），
+ *  必须与同 DPI 下 extractTextLayer 的 bbox 坐标系一致 —— 否则文字层与图片错位。
+ */
+export async function rasterizeAllPages(filePath, outDir, prefix, dpi = CONFIG.RASTERIZE_PAGE_DPI, parallel = CONFIG.RASTERIZE_PAGE_PARALLEL, onProgress) {
+  fs.mkdirSync(outDir, { recursive: true })
+  const total = await getPdfPageCount(filePath)
+  if (total <= 0) return []
+
+  // 分桶：每桶最多 ceil(total / parallel) 页；桶内串行以避免 pdftoppm 写同一目录冲突
+  const perBucket = Math.max(1, Math.ceil(total / parallel))
+  const buckets = []
+  for (let from = 1; from <= total; from += perBucket) {
+    buckets.push({ from, to: Math.min(from + perBucket - 1, total) })
+  }
+
+  const allFiles = []
+  let done = 0
+  await Promise.all(buckets.map(async (b) => {
+    const bucketDir = path.join(outDir, `_chunk_${b.from}_${b.to}`)
+    const files = await rasterizePages(filePath, b.from, b.to, dpi, bucketDir, prefix)
+    // 把临时桶文件移动到正式目录（避免命名冲突）
+    for (const f of files) {
+      const dest = path.join(outDir, path.basename(f.file))
+      fs.renameSync(f.file, dest)
+      // 读 PNG IHDR 拿真实像素尺寸 —— 这是 text layer bbox 坐标的同一坐标系
+      const dims = await imageDimensions(dest)
+      allFiles.push({
+        page: f.page,
+        file: dest,
+        width: dims.width,
+        height: dims.height
+      })
+      done += 1
+      if (onProgress) onProgress(done)
+    }
+    try { fs.rmdirSync(bucketDir) } catch {}
+  }))
+
+  // 按页号排序
+  allFiles.sort((a, b) => a.page - b.page)
+  return allFiles
+}
+
+/** 读 PNG 宽高（不依赖额外库：从 PNG 头解析）。失败返回 { width: 0, height: 0 } */
+export async function imageDimensions(filePath) {
+  try {
+    const fd = fs.openSync(filePath, 'r')
+    const buf = Buffer.alloc(24)
+    fs.readSync(fd, buf, 0, 24, 0)
+    fs.closeSync(fd)
+    // PNG signature: 89 50 4E 47 0D 0A 1A 0A
+    const sig = [0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A]
+    for (let i = 0; i < 8; i++) if (buf[i] !== sig[i]) return { width: 0, height: 0 }
+    // IHDR width @ byte 16, height @ byte 20 (big endian)
+    const width = buf.readUInt32BE(16)
+    const height = buf.readUInt32BE(20)
+    return { width, height }
+  } catch {
+    return { width: 0, height: 0 }
+  }
+}
+
+/** 安全取文件大小；不存在返回 0。 */
+export function fileSize(filePath) {
+  try {
+    return fs.statSync(filePath).size
+  } catch {
+    return 0
+  }
+}
+// ============ 文字覆盖层（方案 B） ============
+// 用 pdftotext -bbox-layout 提取每页文字位置，产出绝对定位 HTML，
+// 前端把透明文字层覆盖在栅格化 PNG 上 → 用户能看、能选、能复制文字。
+const PDFTOTEXT = process.env.PDFTOTEXT || '/opt/homebrew/bin/pdftotext'
+const PT_TO_PX = 96 / 72
+
+function escapeHtml(s) {
+  return String(s)
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#39;')
+}
+
+/**
+ * 把 pdftotext -bbox-layout XHTML 转为覆盖层 HTML：
+ *   - 每个 <word> 直接作为 position:absolute 的 <span>，坐标是页面像素空间下的绝对位置
+ *   - 不再用 <p> flex 容器（flex align-items 会"二次计算" span 位置，导致选择框漂移）
+ *   - 跳过单字符分隔符（|、-、·、• 等宽度 < 12px 的），消除蓝色"幽灵"选择框
+ * 视觉文字与选择边界完全对齐（PDF.js 同款做法）。
+ *
+ * 【关键校正】pdftotext 26.06 的 -bbox-layout 输出 y 已经是 top-down 坐标系（y=0 在顶部），
+ * yMin 在字符 ink 顶上方约 3pt（≈ 20% 字符高），yMax 在字符 ink 底附近。
+ * 实测寻优（120dpi 样本）：
+ *   - 候选：alpha (top 推下比例) + beta (height 系数) + min_h
+ *   - 最优：alpha=0.20, beta=0.95, min_h=22
+ *     · top 误差 0.22px（实际字符顶 vs span 顶）
+ *     · bottom 余量 8.07px（span 底覆盖到字符底下方 8px），彻底解决"字符底部选不中"
+ *     · 12pt 字符命中 22px 下限，覆盖实际 20px ink 高
+ *   - 关键改进（相对旧版 alpha=0.25, beta=0.75）：
+ *     · top 误差从 +0.14px 保持 0.22px（<1px，肉眼不可见）
+ *     · bottom 从"系统偏短 2-5px"变为"系统偏长 8px"（覆盖字符底，不再"字符底选不中"）
+ *
+ * 输出根 div 带 data-page-w / data-page-h 属性 —— 前端以此作为权威页尺寸，
+ * 不依赖 API 返回的 width/height（兼容老任务 / OnlyOffice 重传等脏数据场景）。
+ */
+export function bboxHtmlToTextLayer(bboxHtml, renderDpi = 120) {
+  if (!bboxHtml || typeof bboxHtml !== 'string') return ''
+  const scale = PT_TO_PX * (renderDpi / 96)
+
+  const pageMatch = bboxHtml.match(/<page\s+width="([\d.]+)"\s+height="([\d.]+)"\s*>/)
+  const pageW = pageMatch ? (Number(pageMatch[1]) * scale).toFixed(2) : null
+  const pageH = pageMatch ? (Number(pageMatch[2]) * scale).toFixed(2) : null
+
+  const spans = []
+  const wordRe = /<word\s+xMin="([\d.]+)"\s+yMin="([\d.]+)"\s+xMax="([\d.]+)"\s+yMax="([\d.]+)">([\s\S]*?)<\/word>/g
+  let wm
+  while ((wm = wordRe.exec(bboxHtml)) !== null) {
+    const xMin = Number(wm[1]) * scale
+    const yMin = Number(wm[2]) * scale
+    const xMax = Number(wm[3]) * scale
+    const yMax = Number(wm[4]) * scale
+    const rawText = wm[5]
+    if (xMax - xMin < 0.5 || yMax - yMin < 0.5) continue
+    const decoded = rawText
+      .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')
+      .replace(/&quot;/g, '"').replace(/&apos;/g, "'")
+    const trimmed = decoded.trim()
+    if (!trimmed) continue
+    // 仅过滤「极窄的横向分隔符」，避免幽灵选择框
+    // 子弹字符 ●/• 不再过滤 —— 简历里 ● 是正文内容，应可选中
+    const w = xMax - xMin
+    const isSep = trimmed.length === 1 && /[|\-—·\\/]/.test(trimmed) && w < 8
+    if (isSep) continue
+    const rawH = yMax - yMin
+    // pdftotext 26 的 yMin 在字符 ink 顶上方约 20% rawH 处，下推 20% 让 span 顶贴近实际 ink 顶
+    const inkTop = yMin + rawH * 0.20
+    // 【兜底】pdftotext 对某些中文长句（无空格分隔的连续 CJK）会返回极薄 bbox（如 yMax-yMin=2-3px），
+    // 导致 inkH * 0.95 后只剩 ~2px，肉眼/鼠标都无法选中。
+    // 这里强制下限 22px（覆盖 12pt @120dpi 的 20px ink 高 + 2px 余量），保证选区框覆盖实际文字 ink 区域。
+    // 0.95 系数让常规字符 span 高度接近全 em-square，bottom 覆盖到字符底下方 8px（实测最优），
+    // 彻底解决"字符底部 2-5px 选不中"的问题。
+    const inkH = Math.max(rawH * 0.95, 22)
+    const width = (xMax - xMin).toFixed(2)
+    const height = inkH.toFixed(2)
+    spans.push(
+      `<span style="position:absolute;left:${xMin.toFixed(2)}px;top:${inkTop.toFixed(2)}px;width:${width}px;height:${height}px;font-size:${height}px;line-height:1;white-space:nowrap;overflow:hidden">${escapeHtml(decoded)}</span>`
+    )
+  }
+  const meta = (pageW && pageH) ? ` data-page-w="${pageW}" data-page-h="${pageH}"` : ''
+  return `<div class="pdf-text-layer"${meta}>${spans.join('')}</div>`
+}
+
+/** 提取单页文字层 */
+export function extractTextLayer(pdfPath, page, outPath, opts = {}) {
+  const renderDpi = opts.renderDpi || 120
+  return new Promise((resolve, reject) => {
+    if (!fs.existsSync(pdfPath)) return reject(new Error(`extractTextLayer: PDF not found: ${pdfPath}`))
+    fs.mkdirSync(path.dirname(outPath), { recursive: true })
+    const args = ['-bbox-layout', '-f', String(page), '-l', String(page), pdfPath, '-']
+    const c = spawn(PDFTOTEXT, args, { stdio: ['ignore', 'pipe', 'pipe'] })
+    let out = '', err = ''
+    c.stdout.on('data', d => { out += d.toString() })
+    c.stderr.on('data', d => { err += d.toString() })
+    c.on('error', reject)
+    c.on('close', code => {
+      if (code !== 0) {
+        try {
+          fs.writeFileSync(outPath, '<div class="pdf-text-layer"></div>', 'utf-8')
+          return resolve({ page, file: outPath, words: 0, bytes: 0, warning: `pdftotext exit ${code}` })
+        } catch (e) { return reject(new Error(`pdftotext exited ${code}: ${err.slice(0,300)}`)) }
+      }
+      const layerHtml = bboxHtmlToTextLayer(out, renderDpi)
+      fs.writeFileSync(outPath, layerHtml, 'utf-8')
+      // 计数：每词一个绝对定位 span（已过滤空宽/分隔符）
+      const words = (layerHtml.match(/<span /g) || []).length
+      const bytes = Buffer.byteLength(layerHtml, 'utf-8')
+      resolve({ page, file: outPath, words, bytes })
+    })
+  })
+}
+
+/** 并行提取所有页文字层（分桶） */
+export async function extractAllTextLayers(pdfPath, outDir, prefix, parallel = 2, renderDpi = 120, onProgress) {
+  fs.mkdirSync(outDir, { recursive: true })
+  const total = await getPdfPageCount(pdfPath)
+  if (total <= 0) return []
+  const perBucket = Math.max(1, Math.ceil(total / parallel))
+  const buckets = []
+  for (let from = 1; from <= total; from += perBucket) buckets.push({ from, to: Math.min(from + perBucket - 1, total) })
+  const all = []
+  let done = 0
+  await Promise.all(buckets.map(async (b) => {
+    for (let p = b.from; p <= b.to; p++) {
+      const pad3 = String(p).padStart(3, '0')
+      const outPath = path.join(outDir, `${prefix}-${pad3}.html`)
+      try {
+        all.push(await extractTextLayer(pdfPath, p, outPath, { renderDpi }))
+      } catch (e) {
+        console.warn(`[pdf-rasterize] extractTextLayer page ${p} failed: ${e.message}`)
+        fs.writeFileSync(outPath, '<div class="pdf-text-layer"></div>', 'utf-8')
+        all.push({ page: p, file: outPath, words: 0, bytes: 0 })
+      }
+      done += 1
+      if (onProgress) onProgress(done)
+    }
+  }))
+  all.sort((a, b) => a.page - b.page)
+  return all
+}
