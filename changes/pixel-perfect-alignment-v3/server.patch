+    const out = bboxHtmlToTextLayer(sample, 96)
+    expect(out).toContain('class="pdf-text-layer"')
+    // 新结构：每个 word 一个 span，无 <p> 行容器
+    expect((out.match(/<span /g) || []).length).toBe(2)
+    expect((out.match(/<p /g) || []).length).toBe(0)
