+    const sample = `<?xml version="1.0"?>
+<page width="612.000000" height="792.000000">
+  <block xMin="100" yMin="700" xMax="200" yMax="712">
+    <line xMin="100" yMin="700" xMax="200" yMax="712">
+      <word xMin="100" yMin="700" xMax="150" yMax="712">Hello</word>
+      <word xMin="155" yMin="700" xMax="200" yMax="712">World</word>
+    </line>
+  </block>
